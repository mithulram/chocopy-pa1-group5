import java.util.ArrayList;
import java.util.List;

import java_cup.runtime.*;
import chocopy.common.astnodes.*;

/* The following code section is copied verbatim to the generated
 * parser class. */
parser code {:

    /* The following fields and methods deal with error reporting
     * Avoid changing these unless you know what you are doing. */

    /** Node that accumulates error messages to be added to the Program
     *  node produced as a result. */
    public final Errors errors = new Errors(new ArrayList<>());

    /** Return the Program node that results from parsing the stream of
     *  tokens produced by lexical analysis.  In the case of syntax errors,
     *  the program may be empty, but will have error messages. */
    public Program parseProgram(boolean debug) {
        try {
            Symbol result = debug ? debug_parse() : parse();
            if (result == null || !(result.value instanceof Program)) {
                return new Program(new Location(0, 0), new Location(0, 0),
                                   new ArrayList<Declaration>(),
                                   new ArrayList<Stmt>(),
                                   errors);
            } else {
                return (Program) result.value;
            }
        } catch (RuntimeException excp) {
            throw excp;
        } catch (Exception excp) {
            String msg =
                String.format("Internal parser error detected: %s%n", excp);
            throw new AssertionError(msg);
        }
    }

    @Override
    public SymbolFactory getSymbolFactory() {
        return ((ChocoPyLexer) getScanner()).symbolFactory;
    }

    @Override
    public void syntax_error(Symbol cur_token) {
        String token = symbl_name_from_id(cur_token.sym);
        /* changed from the starter: ask the lexer for this token's text.
         * yytext() is only the latest match, which gave wrong text for
         * DEDENTs (whitespace pushed back) and for tokens made at EOF */
        String text = ((ChocoPyLexer) getScanner()).getTokenText(cur_token);
        errors.syntaxError(
            ((ComplexSymbolFactory.ComplexSymbol) cur_token).xleft,
            ((ComplexSymbolFactory.ComplexSymbol) cur_token).xright,
            "Parse error near token %s: %s", token, text);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) {
        /* Do not die */
    }

    /** Default reductions in "consistent" states, like Bison does by
     *  default. If a state can only do one thing - one particular
     *  reduction - we let it do that reduction whatever the lookahead is.
     *
     *  We added this because of a bug we found: "z = 5" followed by a line
     *  starting with "lambda". To reduce "stmt ::= simple_stmt NEWLINE",
     *  CUP needs a valid lookahead, and RESERVED isn't one. So it reported
     *  the error first, and recovery then popped the finished "z = 5" off
     *  the stack - a correct statement just vanished from the AST. (The
     *  reference has the same problem.)
     *
     *  This can't move the reported error: the parser would have done the
     *  same reduction on any valid token, and reducing reads no input.
     *  CUP actually has an option for this (-compact_red), but it's set in
     *  pom.xml and we're not allowed to touch that, so we patch the table.
     *
     *  How CUP stores the table (we looked at lr_parser.get_action): each
     *  row is (symbol, action) pairs, last pair is the default (-1, action).
     *  action > 0 = shift, < 0 = reduce, 0 = error. */
    private void enableDefaultReductions() {
        short[][] table = action_tab.clone();     /* copy, the original is static */
        for (int state = 0; state < table.length; state++) {
            short[] row = table[state];
            int defaultPair = row.length - 2;
            if (defaultPair < 0 || row[defaultPair] != -1 || row[defaultPair + 1] != 0) {
                continue;                          /* already has a default */
            }
            short onlyReduce = 0;
            boolean consistent = true;
            for (int i = 0; i < defaultPair && consistent; i += 2) {
                short action = row[i + 1];
                if (action > 0) {
                    consistent = false;            /* shift -> lookahead matters */
                } else if (action < 0) {
                    if (onlyReduce == 0) {
                        onlyReduce = action;
                    } else if (onlyReduce != action) {
                        consistent = false;        /* more than one reduction */
                    }
                }
            }
            if (consistent && onlyReduce != 0) {
                short[] patched = row.clone();
                patched[defaultPair + 1] = onlyReduce;
                table[state] = patched;
            }
        }
        action_tab = table;
    }
:}

/* runs at the start of each parse, after CUP has loaded its tables */
init with {:
    enableDefaultReductions();
:};


/**************************************************************************
 * ChocoPy grammar - PA1, group 5
 *
 * The rules follow Figure 3 in the manual, and we kept the manual's names
 * where we could so you can read both side by side.
 *
 * Some notes before reading the rules:
 *
 * Locations: a node goes from the left end of its first symbol to the
 * right end of its last one (CUP gives us <name>xleft / <name>xright).
 * Most of our time went into matching the reference here. Compound
 * statements end at the DEDENT that closes them; functions and classes
 * end where their body ends.
 *
 * Precedence: done with CUP's precedence declarations instead of one
 * nonterminal per level. We kept the manual's expr/cexpr split though,
 * because that's what makes "True == not False" a syntax error.
 *
 * Error recovery ended up in three parts:
 *  - every list (top-level decls, statements, block statements, class
 *    members) has an `error` alternative. They are separate nonterminals
 *    on purpose, otherwise two error rules clash (see top_decls).
 *  - extra rules for common mistakes (bad initial value, broken
 *    def/class/if/elif/while/for header). These all resume at the next
 *    NEWLINE. We first anchored on the colon, but when the colon never
 *    came CUP gave up on the whole rest of the file.
 *  - default reductions (enableDefaultReductions above).
 * None of this can change where the FIRST error is reported (the part
 * that's graded), since `error` never appears in real input. We checked
 * the effect with tools/recovery_quality.py.
 **************************************************************************/


/* The following code section is copied verbatim to the class that performs
 * production-rule actions. */
action code {:

    /** Return a mutable list initially containing the single value ITEM. */
    <T> List<T> single(T item) {
        List<T> list = new ArrayList<>();
        if (item != null) {
            list.add(item);
        }
        return list;
    }

    /** If ITEM is non-null, appends it to the end of LIST.  Then returns
     *  LIST. */
    <T> List<T> combine(List<T> list, T item) {
        if (item != null) {
            list.add(item);
        }
        return list;
    }

    /** Return a mutable empty list. */
    <T> List<T> empty() {
        return new ArrayList<T>();
    }

    /** Return the leftmost non-whitespace location in NODES, or null if NODES
     *  is empty.  Assumes that the nodes of NODES are ordered in increasing
     *  order of location, from left to right. */
    ComplexSymbolFactory.Location getLeft(List<? extends Node> nodes) {
        if (nodes.isEmpty()) {
            return null;
        }
        Node first = nodes.get(0);
        return new ComplexSymbolFactory.Location(first.getLocation()[0],
                                                 first.getLocation()[1]);
    }

    /** small helper, we build a lot of Identifier nodes */
    Identifier identifier(ComplexSymbolFactory.Location left,
                          ComplexSymbolFactory.Location right, String name) {
        return new Identifier(left, right, name);
    }

:}


/* ------------------------------------------------------------------------
 * Terminals
 *
 * Same names as the reference lexer uses, so our error messages look the
 * same ("Parse error near token EQEQ: ==").
 * ------------------------------------------------------------------------ */

/* made by the lexer from line breaks and indentation */
terminal NEWLINE, INDENT, DEDENT;

/* for strings the value is the contents with escapes already applied */
terminal String  IDENTIFIER, STRING, IDSTRING;
terminal Integer INTEGER;

/* keywords */
terminal CLASS, DEF, GLOBAL, NONLOCAL, PASS, RETURN;
terminal IF, ELIF, ELSE, WHILE, FOR, IN;
terminal NONE, TRUE, FALSE;

/* operators carry their spelling, which is what BinaryExpr/UnaryExpr
 * want in their `operator` field */
terminal String PLUS, MINUS, TIMES, IDIV, MOD;
terminal String EQEQ, NEQ, LT, GT, LEQ, GEQ, IS;
terminal String AND, OR, NOT;

/* delimiters */
terminal EQ, LPAREN, RPAREN, LINDEX, RINDEX, COMMA, COLON, DOT, ARROW;

/* never used in a rule, so getting one of these = syntax error */
terminal RESERVED;
terminal UNRECOGNIZED;

/* fake token, the lexer never makes it. Only there so unary minus can
 * get its own precedence with %prec */
terminal UMINUS;


/* ------------------------------------------------------------------------
 * Nonterminals
 * ------------------------------------------------------------------------ */

non terminal Program              program;

/* declarations */
non terminal List<Declaration>    top_decls, func_decls;
non terminal List<Declaration>    class_body, class_members;
non terminal Declaration          class_member;
non terminal ClassDef             class_def, class_header;
non terminal FuncDef              func_def, func_header;
non terminal TypeAnnotation       return_type_opt;
non terminal List<TypedVar>       typed_var_list_opt, typed_var_list;
non terminal TypedVar             typed_var;
non terminal TypeAnnotation       type;
non terminal VarDef               var_def;
non terminal GlobalDecl           global_decl;
non terminal NonLocalDecl         nonlocal_decl;

/* statements */
non terminal List<Stmt>           stmt_list;
non terminal List<Stmt>           block, block_stmts, elif_else;
non terminal Stmt                 stmt, simple_stmt;
non terminal Expr                 if_header, elif_header, while_header;
non terminal ForStmt              for_header;
non terminal List<Expr>           assign_targets;
non terminal Expr                 target;

/* expressions */
non terminal Expr                 expr, cexpr;
non terminal Literal              literal;
non terminal MemberExpr           member_expr;
non terminal IndexExpr            index_expr;
non terminal List<Expr>           expr_list_opt, expr_list;


/* ------------------------------------------------------------------------
 * Precedence, lowest first (table in manual 4.1)
 *
 * On a shift/reduce conflict CUP compares the rule's precedence (its last
 * terminal, or the %prec one) with the lookahead's.
 * ------------------------------------------------------------------------ */

precedence right    IF, ELSE;                        /* a if c else b    */
precedence left     OR;
precedence left     AND;
precedence right    NOT;                             /* prefix, unary    */
precedence nonassoc EQEQ, NEQ, LT, GT, LEQ, GEQ, IS; /* a < b < c: error */
precedence left     PLUS, MINUS;
precedence left     TIMES, IDIV, MOD;
precedence right    UMINUS;                          /* prefix, unary    */
precedence left     DOT, LINDEX;                     /* a.b[c].d         */


start with program;


/**************************************************************************
 *  PROGRAM
 *
 *  program ::= [var_def | func_def | class_def]* stmt*
 **************************************************************************/

/* The program goes from the first decl/statement to the last token we
 * read (NEWLINE or DEDENT), e.g. [1,1,36,24] for coverage.py.
 *
 * Careful: use the symbol positions, not the AST nodes. Our fuzzer found
 * a program starting with `pass` - pass has no node, but the reference
 * still starts the program at it. top_decls can be empty though, and an
 * empty production has no real position, so for decls we use getLeft. */
program ::= top_decls:d stmt_list:s
        {: RESULT = new Program(d.isEmpty() ? sxleft : getLeft(d), sxright,
                                d, s, errors); :}
        | top_decls:d
        {:
            /* empty file -> [0,0,0,0] */
            RESULT = new Program(getLeft(d), d.isEmpty() ? null : dxright,
                                 d, empty(), errors);
        :}
        ;

/* Top-level declarations. With `error` here we can skip a broken
 * declaration and go on with the next ones.
 *
 * We first tried one error rule for decls and statements together, but
 * right after top_decls both a declaration and a statement can start, and
 * two live error rules there gave a reduce/reduce conflict. So stmt_list
 * only takes `error` after its first statement. An error in the very
 * first statement just ends up here, which is fine. */
top_decls ::= /* empty */                  {: RESULT = empty(); :}
            | top_decls:l var_def:v        {: RESULT = combine(l, v); :}
            | top_decls:l func_def:f       {: RESULT = combine(l, f); :}
            | top_decls:l class_def:c      {: RESULT = combine(l, c); :}
            | top_decls:l error            {: RESULT = l; :}
            ;


/**************************************************************************
 *  CLASSES
 *
 *  class_def  ::= class ID ( ID ) : NEWLINE INDENT class_body DEDENT
 *  class_body ::= pass NEWLINE | [var_def | func_def]+
 **************************************************************************/

class_def ::= class_header:h NEWLINE INDENT class_body:b DEDENT
        {:
            /* ends where the body ends - if the last member is a method,
             * that's the method's DEDENT (same as the reference) */
            RESULT = new ClassDef(hxleft, bxright, h.name, h.superClass, b);
        :}

        /* recovery for a broken header like "class Thing:" (no superclass).
         * Skip the rest of the line, then parse the body if there is one,
         * so its errors still show up and its DEDENT is used up here. We
         * resume at NEWLINE because it always comes soon - with the colon
         * as anchor CUP sometimes searched to EOF and gave up. */
        | CLASS IDENTIFIER error NEWLINE                              {: RESULT = null; :}
        | CLASS IDENTIFIER error NEWLINE INDENT class_body DEDENT     {: RESULT = null; :}
        ;

/* Just the header. Returns a ClassDef with no members and class_def
 * builds the real one later.
 * Why a separate rule: once the header is reduced, its states are off the
 * stack, so an error much later (after the body) can't land in the
 * "CLASS IDENTIFIER error" rule and throw the whole class away. That
 * happened to us. Same trick for def/if/elif/while/for below. */
class_header ::= CLASS:c IDENTIFIER:name LPAREN IDENTIFIER:sup RPAREN COLON:colon
        {: RESULT = new ClassDef(cxleft, colonxright,
                                 identifier(namexleft, namexright, name),
                                 identifier(supxleft, supxright, sup),
                                 empty()); :}
        ;

class_body ::= PASS NEWLINE                {: RESULT = empty(); :}
             | class_members:m             {: RESULT = m; :}
             ;

class_members ::= class_member:m                   {: RESULT = single(m); :}
                | class_members:l class_member:m   {: RESULT = combine(l, m); :}
                | error                            {: RESULT = empty(); :}
                | class_members:l error            {: RESULT = l; :}
                ;

class_member ::= var_def:v                 {: RESULT = v; :}
               | func_def:f                {: RESULT = f; :}
               ;


/**************************************************************************
 *  FUNCTIONS
 *
 *  func_def  ::= def ID ( [typed_var [, typed_var]*]? ) [-> type]? :
 *                NEWLINE INDENT func_body DEDENT
 *  func_body ::= [global_decl | nonlocal_decl | var_def | func_def]* stmt+
 *
 *  We wrote func_body inline (func_decls block_stmts) so the action gets
 *  both parts without needing a helper class.
 **************************************************************************/

func_def ::= func_header:h NEWLINE INDENT func_decls:decls block_stmts:body DEDENT
        {: RESULT = new FuncDef(hxleft, bodyxright, h.name, h.params, h.returnType,
                                decls, body); :}

        /* recovery for a broken header (e.g. parameter without a type),
         * works like the class one above */
        | DEF IDENTIFIER error NEWLINE                                      {: RESULT = null; :}
        | DEF IDENTIFIER error NEWLINE INDENT func_decls block_stmts DEDENT {: RESULT = null; :}
        ;

/* only the header, returned as a FuncDef with an empty body
 * (see class_header for why) */
func_header ::= DEF:d IDENTIFIER:name LPAREN typed_var_list_opt:params RPAREN
                return_type_opt:ret COLON:c
        {:
            /* no "-> type": the reference puts ClassType "<None>" there,
             * located at the colon (found that out by probing it) */
            TypeAnnotation returnType = (ret != null)
                ? ret
                : new ClassType(cxleft, cxright, "<None>");
            RESULT = new FuncDef(dxleft, cxright,
                                 identifier(namexleft, namexright, name),
                                 params, returnType, empty(), empty());
        :}
        ;

return_type_opt ::= /* empty */            {: RESULT = null; :}
                  | ARROW type:t           {: RESULT = t; :}
                  ;

typed_var_list_opt ::= /* empty */         {: RESULT = empty(); :}
                     | typed_var_list:l    {: RESULT = l; :}
                     ;

typed_var_list ::= typed_var:v                            {: RESULT = single(v); :}
                 | typed_var_list:l COMMA typed_var:v     {: RESULT = combine(l, v); :}
                 ;

/* Declarations at the start of a function body.
 *
 * No `error` rule here, on purpose. We had one at first, but when the
 * only statement of a function was broken, CUP recovered in "declaration
 * mode", threw away the function's DEDENT and gave up at EOF (the
 * reference does exactly that too). Now the error goes into block_stmts
 * instead. Can't have both - two live error rules conflict. A bad initial
 * value is still caught by the var_def rule. */
func_decls ::= /* empty */                 {: RESULT = empty(); :}
             | func_decls:l global_decl:g  {: RESULT = combine(l, g); :}
             | func_decls:l nonlocal_decl:n {: RESULT = combine(l, n); :}
             | func_decls:l var_def:v      {: RESULT = combine(l, v); :}
             | func_decls:l func_def:f     {: RESULT = combine(l, f); :}
             ;

global_decl ::= GLOBAL:g IDENTIFIER:name NEWLINE
        {: RESULT = new GlobalDecl(gxleft, namexright,
                                   identifier(namexleft, namexright, name)); :}
        ;

nonlocal_decl ::= NONLOCAL:n IDENTIFIER:name NEWLINE
        {: RESULT = new NonLocalDecl(nxleft, namexright,
                                     identifier(namexleft, namexright, name)); :}
        ;


/**************************************************************************
 *  VARIABLES AND TYPES
 *
 *  var_def   ::= typed_var = literal NEWLINE
 *  typed_var ::= ID : type
 *  type      ::= ID | IDSTRING | [ type ]
 **************************************************************************/

var_def ::= typed_var:v EQ literal:value NEWLINE
        {: RESULT = new VarDef(vxleft, valuexright, v, value); :}

        /* recovery for a value that isn't a literal, like "x:int = 1 + 2".
         * Without this, CUP continued at the leftover "2" as a statement,
         * and since declarations can't come after statements, every decl
         * after it failed as well. Now we skip the line and stay in decls. */
        | typed_var EQ error NEWLINE
        {: RESULT = null; :}
        ;

typed_var ::= IDENTIFIER:name COLON type:t
        {: RESULT = new TypedVar(namexleft, txright,
                                 identifier(namexleft, namexright, name), t); :}
        ;

type ::= IDENTIFIER:name                   {: RESULT = new ClassType(namexleft, namexright, name); :}
       | IDSTRING:name                     {: RESULT = new ClassType(namexleft, namexright, name); :}
       | LINDEX:l type:t RINDEX:r          {: RESULT = new ListType(lxleft, rxright, t); :}
       ;


/**************************************************************************
 *  STATEMENTS
 *
 *  stmt  ::= simple_stmt NEWLINE
 *          | if expr : block [elif expr : block]* [else : block]?
 *          | while expr : block
 *          | for ID in expr : block
 *  block ::= NEWLINE INDENT stmt+ DEDENT
 **************************************************************************/

/* statements at top level */
stmt_list ::= stmt:s                       {: RESULT = single(s); :}
            | stmt_list:l stmt:s           {: RESULT = combine(l, s); :}
            | stmt_list:l error            {: RESULT = l; :}
            ;

/* statements inside a block or a function body. This one can start with
 * `error` (nothing competes with it here), so a mistake in the first line
 * of a block stays inside that block. */
block_stmts ::= stmt:s                     {: RESULT = single(s); :}
              | error                      {: RESULT = empty(); :}
              | block_stmts:l stmt:s       {: RESULT = combine(l, s); :}
              | block_stmts:l error        {: RESULT = l; :}
              ;

/* the block ends at its DEDENT, and if/while/for take their end from it,
 * e.g. an `if` ends at [19,1,19,8] when the next line has 8 spaces
 * (that's how the reference does it) */
block ::= NEWLINE INDENT block_stmts:s DEDENT   {: RESULT = s; :}
        ;

stmt ::= simple_stmt:s NEWLINE             {: RESULT = s; :}

       | if_header:cond block:then
        {: RESULT = new IfStmt(condxleft, thenxright, cond, then, empty()); :}

       /* with elif/else it ends where that part ends. We use two rules
        * instead of checking if `rest` is empty, because "else: pass"
        * gives an empty list but still ends at the else-block's DEDENT
        * (another one the fuzzer caught) */
       | if_header:cond block:then elif_else:rest
        {: RESULT = new IfStmt(condxleft, restxright, cond, then, rest); :}

       | while_header:cond block:body
        {: RESULT = new WhileStmt(condxleft, bodyxright, cond, body); :}

       | for_header:h block:body
        {: RESULT = new ForStmt(hxleft, bodyxright, h.identifier, h.iterable, body); :}

       /* recovery for a broken if/while/for header ("while x $ y:", or
        * no colon). Skip the line, and if a block follows parse it too so
        * its INDENT doesn't cause more errors. The statement is dropped.
        * The block has to be optional: something like "if $ fy = 1" (a
        * typo of "iffy") looks like a header but has no block. */
       | IF error NEWLINE                                         {: RESULT = null; :}
       | IF error NEWLINE INDENT block_stmts DEDENT               {: RESULT = null; :}
       | IF error NEWLINE INDENT block_stmts DEDENT elif_else     {: RESULT = null; :}
       | WHILE error NEWLINE                                      {: RESULT = null; :}
       | WHILE error NEWLINE INDENT block_stmts DEDENT            {: RESULT = null; :}
       | FOR error NEWLINE                                        {: RESULT = null; :}
       | FOR error NEWLINE INDENT block_stmts DEDENT              {: RESULT = null; :}
       ;

/* headers of if/elif/while/for. They start at the keyword, so condxleft
 * above is really the position of `if`/`while`. Separate rules for the
 * same reason as class_header. */
if_header ::= IF expr:cond COLON           {: RESULT = cond; :}
            ;

elif_header ::= ELIF expr:cond COLON       {: RESULT = cond; :}
              ;

while_header ::= WHILE expr:cond COLON     {: RESULT = cond; :}
               ;

/* returns a ForStmt without body, stmt builds the full one */
for_header ::= FOR:f IDENTIFIER:name IN expr:iter COLON:c
        {: RESULT = new ForStmt(fxleft, cxright,
                                identifier(namexleft, namexright, name),
                                iter, empty()); :}
             ;

/* elif doesn't exist in the AST: "if a: X elif b: Y else: Z" becomes
 * "if a: X else: [if b: Y else: Z]". This rule builds that else-body:
 * either the else block, or a list with one nested IfStmt per elif.
 * Right recursion, so the nesting comes out the right way by itself. */
elif_else ::= ELSE COLON block:b           {: RESULT = b; :}
            | elif_header:cond block:then
            {: RESULT = single(new IfStmt(condxleft, thenxright, cond, then, empty())); :}
            | elif_header:cond block:then elif_else:rest
            {: RESULT = single(new IfStmt(condxleft, restxright, cond, then, rest)); :}
            /* broken elif header, same idea as in stmt */
            | ELIF error NEWLINE                                      {: RESULT = empty(); :}
            | ELIF error NEWLINE INDENT block_stmts DEDENT            {: RESULT = empty(); :}
            | ELIF error NEWLINE INDENT block_stmts DEDENT elif_else  {: RESULT = empty(); :}
            ;

/* pass has no AST node. single()/combine() skip nulls, so it just doesn't
 * show up in the list (the reference does the same) */
simple_stmt ::= PASS                       {: RESULT = null; :}
              | expr:e                     {: RESULT = new ExprStmt(exleft, exright, e); :}
              | RETURN:r                   {: RESULT = new ReturnStmt(rxleft, rxright, null); :}
              | RETURN:r expr:e            {: RESULT = new ReturnStmt(rxleft, exright, e); :}
              | assign_targets:ts expr:e   {: RESULT = new AssignStmt(tsxleft, exright, ts, e); :}
              ;

/* [target =]+ expr, so "a = b = 1" has two targets. No conflict: after
 * a name, "=" means target, anything else means expression. */
assign_targets ::= target:t EQ                     {: RESULT = single(t); :}
                 | assign_targets:l target:t EQ    {: RESULT = combine(l, t); :}
                 ;

target ::= IDENTIFIER:name                 {: RESULT = identifier(namexleft, namexright, name); :}
         | member_expr:m                   {: RESULT = m; :}
         | index_expr:i                    {: RESULT = i; :}
         ;


/**************************************************************************
 *  EXPRESSIONS
 *
 *  expr  ::= cexpr | not expr | expr [and | or] expr | expr if expr else expr
 *  cexpr ::= ID | literal | [ [expr [, expr]*]? ] | ( expr )
 *          | member_expr | index_expr | member_expr ( args ) | ID ( args )
 *          | cexpr bin_op cexpr | - cexpr
 **************************************************************************/

expr ::= cexpr:e                           {: RESULT = e; :}
       | NOT:op expr:e                     {: RESULT = new UnaryExpr(opxleft, exright, op, e); :}
       | expr:l AND:op expr:r              {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
       | expr:l OR:op expr:r               {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
       /* the AST stores the condition first, but the text starts with a,
        * so the location starts at a */
       | expr:a IF expr:cond ELSE expr:b   {: RESULT = new IfExpr(axleft, bxright, cond, a, b); :}
       ;

cexpr ::= IDENTIFIER:name                  {: RESULT = identifier(namexleft, namexright, name); :}
        | literal:l                        {: RESULT = l; :}
        | LINDEX:l expr_list_opt:es RINDEX:r
                                           {: RESULT = new ListExpr(lxleft, rxright, es); :}
        /* parens don't make a node; the inner expr keeps its location
         * without them (see the "(-foo)" example in the spec) */
        | LPAREN expr:e RPAREN             {: RESULT = e; :}
        | member_expr:m                    {: RESULT = m; :}
        | index_expr:i                     {: RESULT = i; :}
        | member_expr:m LPAREN expr_list_opt:args RPAREN:r
                                           {: RESULT = new MethodCallExpr(mxleft, rxright, m, args); :}
        | IDENTIFIER:name LPAREN expr_list_opt:args RPAREN:r
                                           {: RESULT = new CallExpr(namexleft, rxright,
                                                  identifier(namexleft, namexright, name), args); :}

        /* binary operators, precedence comes from the table above */
        | cexpr:l PLUS:op cexpr:r          {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l MINUS:op cexpr:r         {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l TIMES:op cexpr:r         {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l IDIV:op cexpr:r          {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l MOD:op cexpr:r           {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l EQEQ:op cexpr:r          {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l NEQ:op cexpr:r           {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l LT:op cexpr:r            {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l GT:op cexpr:r            {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l LEQ:op cexpr:r           {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l GEQ:op cexpr:r           {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l IS:op cexpr:r            {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}

        /* unary minus: tighter than *, looser than . and [] */
        | MINUS:op cexpr:e                 {: RESULT = new UnaryExpr(opxleft, exright, op, e); :}
                                           %prec UMINUS
        ;

member_expr ::= cexpr:obj DOT IDENTIFIER:name
        {: RESULT = new MemberExpr(objxleft, namexright, obj,
                                   identifier(namexleft, namexright, name)); :}
        ;

index_expr ::= cexpr:list LINDEX expr:index RINDEX:r
        {: RESULT = new IndexExpr(listxleft, rxright, list, index); :}
        ;

expr_list_opt ::= /* empty */              {: RESULT = empty(); :}
                | expr_list:l              {: RESULT = l; :}
                ;

expr_list ::= expr:e                       {: RESULT = single(e); :}
            | expr_list:l COMMA expr:e     {: RESULT = combine(l, e); :}
            ;

literal ::= NONE:n                         {: RESULT = new NoneLiteral(nxleft, nxright); :}
          | TRUE:t                         {: RESULT = new BooleanLiteral(txleft, txright, true); :}
          | FALSE:f                        {: RESULT = new BooleanLiteral(fxleft, fxright, false); :}
          | INTEGER:i                      {: RESULT = new IntegerLiteral(ixleft, ixright, i); :}
          | STRING:s                       {: RESULT = new StringLiteral(sxleft, sxright, s); :}
          | IDSTRING:s                     {: RESULT = new StringLiteral(sxleft, sxright, s); :}
          ;
